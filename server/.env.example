# Obrigatório: chave da sua conta Google Stitch.
STITCH_API_KEY=cole_sua_chave_aqui

# Alternativa à API key, quando aplicável.
STITCH_ACCESS_TOKEN=
GOOGLE_CLOUD_PROJECT=

# Porta local do servidor MCP.
PORT=3000

# Opcional. Proteção adicional do endpoint /mcp.
# Use apenas se o cliente MCP/gateway estiver configurado para enviar este Bearer token.
MCP_BEARER_TOKEN=

# Tamanho máximo de HTML retornado inline ao modelo.
MAX_HTML_CHARS=60000
