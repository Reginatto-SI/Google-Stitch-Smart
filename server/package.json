{
  "name": "google-stitch-smart-mcp",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "MCP bridge for Google Stitch with prompt-engineering-aware workflow for ChatGPT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
