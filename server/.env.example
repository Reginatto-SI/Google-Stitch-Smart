# OAuth Google recomendado para acessar projetos/telas existentes do Stitch.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# ID do projeto Google Cloud usado pelo OAuth/Stitch API. Não é o ID visual do projeto Stitch.
GOOGLE_CLOUD_PROJECT=

# Opcional: fixe explicitamente a URI cadastrada no OAuth Client.
GOOGLE_OAUTH_REDIRECT_URI=https://google-stitch-smart.onrender.com/oauth/callback

# Fallbacks legados/temporários.
STITCH_ACCESS_TOKEN=
STITCH_API_KEY=

PORT=3000

# Opcional. Proteção adicional do endpoint /mcp.
MCP_BEARER_TOKEN=

MAX_HTML_CHARS=60000

# Timeout interno somente para geração de tela. Mantê-lo abaixo do timeout do cliente MCP ajuda o plugin a devolver um estado seguro e reconciliar a operação em vez de deixar o cliente concluir que houve falha definitiva.
STITCH_GENERATION_TIMEOUT_MS=45000
